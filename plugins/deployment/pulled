#!/usr/bin/env bun
// wannabe: --to <context> [--dry-run] — pull the service's image on the host
//
// Runs docker compose pull for spec.service on the context's host. The running service is not touched.
import { get, host, parseArgs, run } from "../../lib/plugin.ts";

const args = parseArgs();
const target = await host(args.context);
const remoteDir = await get(`${args.context}/deployment`, "spec.remoteDir");
const service = await get(`${args.context}/deployment`, "spec.service");
await run(["ssh", target, `cd '${remoteDir}' && docker compose pull '${service}'`]);
