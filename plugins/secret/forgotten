#!/usr/bin/env bun
// wannabe: <name> [--dry-run] — remove a secret from this computer's secret store
//
// Removes only what 'secret stored' kept. An environment variable or a declared command is not touched.
// Ends the same whether or not the secret was there.
import { storeDelete } from "../../lib/secret.ts";
import { die, parseArgs, say } from "../../lib/plugin.ts";

const args = parseArgs(process.argv.slice(2), { context: "none", positional: true });
const [name, ...extra] = args.rest;
if (!name || extra.length) die(2, "which secret? wannabe secret forgotten <name>");

if (args.dryRun) {
  say(`dry run: would remove '${name}' from the secret store`);
  process.exit(0);
}
try {
  say((await storeDelete(name)) ? `forgot '${name}'` : `'${name}' was not stored`);
} catch (error) {
  die(1, `the operating system's secret store could not be changed: ${(error as Error).message}`);
}
