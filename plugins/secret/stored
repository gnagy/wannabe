#!/usr/bin/env bun
// wannabe: <name> [--dry-run] — keep a secret in this computer's secret store
//
// Reads the value hidden from the terminal, or from standard input when that is piped
// (pbpaste | wannabe secret stored <name>), and keeps it in the operating system's store: Keychain,
// libsecret or Credential Manager. Storing again replaces the value, which is how a token is rotated.
// An environment variable WANNABE_SECRET_<NAME> or a declared command still takes precedence when it is set.
import { declaration, envName, find, storeSet } from "../../lib/secret.ts";
import { die, parseArgs, say } from "../../lib/plugin.ts";

const args = parseArgs(process.argv.slice(2), { context: "none", positional: true });
const [name, ...extra] = args.rest;
if (!name || extra.length) die(2, "which secret? wannabe secret stored <name>");

const declaredAs = await declaration(name);
if (!declaredAs) say(`note: '${name}' is not declared in .wannabe/secrets.yaml, so 'secret checked' will not list it`);
if (declaredAs?.description) say(declaredAs.description);
if (args.dryRun) {
  say(`dry run: would store '${name}' in the secret store`);
  process.exit(0);
}

/** One line from the terminal with the echo off, or everything piped in. */
async function readValue(): Promise<string> {
  if (!process.stdin.isTTY) return (await Bun.stdin.text()).trim();
  if (process.platform === "win32") die(1, "no hidden prompt on Windows; pipe the value in instead");
  process.stderr.write(`${name}: `);
  Bun.spawnSync(["stty", "-echo"], { stdin: "inherit" });
  try {
    for await (const line of console) return line.trim();
    return "";
  } finally {
    Bun.spawnSync(["stty", "echo"], { stdin: "inherit" });
    process.stderr.write("\n");
  }
}

const value = await readValue();
if (!value) die(1, "no value given; nothing stored");
try {
  await storeSet(name, value);
} catch (error) {
  die(1, `the operating system's secret store refused it: ${(error as Error).message}\n  in CI or without a secret store, set ${envName(name)} instead`);
}
say(`stored '${name}'`);
const found = await find(name);
if ("source" in found && found.source !== "store") say(`but ${found.source === "environment" ? envName(name) : "its declared command"} takes precedence while it is set`);
