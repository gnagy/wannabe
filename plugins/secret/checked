#!/usr/bin/env bun
// wannabe: — list the secrets .wannabe/secrets.yaml declares, and where each would come from
//
// Never prints a value. Exits 1 when a declared secret cannot be found, 3 when the project declares none.
import { declared, envName, find } from "../../lib/secret.ts";
import { die, parseArgs, say } from "../../lib/plugin.ts";

parseArgs(process.argv.slice(2), { context: "none" });
const secrets = await declared();
if (secrets.length === 0) die(3, "no secrets declared in .wannabe/secrets.yaml");

let missing = 0;
for (const { name, description } of secrets) {
  const found = await find(name);
  if ("source" in found) {
    console.log(`${name}\t${found.source === "environment" ? `from ${envName(name)}` : found.source === "command" ? "from its command" : "in the secret store"}`);
  } else {
    missing++;
    console.log(`${name}\tMISSING${found.reason ? `: ${found.reason}` : ""}`);
    if (description) say(`  ${name}: ${description}`);
    say(`  wannabe secret stored ${name}`);
  }
}
if (missing) process.exit(1);
